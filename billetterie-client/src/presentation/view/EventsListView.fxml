<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="700.0" prefWidth="800.0" spacing="20.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.EventsListController">
   <padding>
      <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
   </padding>
   <children>
      <HBox alignment="CENTER_LEFT" spacing="20.0">
         <children>
            <VBox spacing="5.0">
               <children>
                  <Label styleClass="h2, text-primary" text="À l'affiche" />
                  <Label styleClass="h4, text-secondary" text="Découvrez les meilleurs événements sportifs" />
               </children>
            </VBox>
             <HBox HBox.hgrow="ALWAYS" />
             <ComboBox fx:id="sportCombo" prefHeight="45.0" prefWidth="200.0" promptText="Filtrer par sport" styleClass="form-control" />
             <TextField fx:id="searchField" prefHeight="45.0" prefWidth="350.0" promptText="Rechercher un événement, une équipe..." styleClass="form-control" />
             <Button mnemonicParsing="false" onAction="#handleSearch" styleClass="btn, btn-primary" text="🔍 Rechercher" />
         </children>
      </HBox>
      
      <ScrollPane fitToWidth="true" styleClass="scroll-pane" VBox.vgrow="ALWAYS">
         <content>
            <FlowPane fx:id="eventsContainer" hgap="20.0" vgap="20.0">
               <padding>
                  <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
               </padding>
            </FlowPane>
         </content>
      </ScrollPane>
   </children>
</VBox>
