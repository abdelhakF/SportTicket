<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<BorderPane fx:id="mainBorderPane" prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.AdminShellController">
   <left>
      <VBox prefWidth="260.0" spacing="0.0" styleClass="sidebar" BorderPane.alignment="CENTER">
         <children>
             <!-- Logo Area -->
            <StackPane prefHeight="110.0" styleClass="sidebar-header">
               <children>
                  <VBox alignment="CENTER" spacing="5.0">
                     <children>
                        <Label styleClass="sidebar-title" text="SPORTTICKET PRO" />
                        <Label styleClass="sidebar-subtitle" text="ADMINISTRATION" />
                     </children>
                  </VBox>
               </children>
            </StackPane>
            
            <!-- Navigation Items -->
            <VBox spacing="8.0" VBox.vgrow="ALWAYS">
               <padding>
                  <Insets bottom="20.0" left="10.0" right="10.0" top="20.0" />
               </padding>
               <children>
                  <Button fx:id="btnUsers" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showUsers" styleClass="button-sidebar" text="   👥   Gestion Utilisateurs" />
                  <Button fx:id="btnEvents" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showEvents" styleClass="button-sidebar" text="   📅   Gestion Événements" />
                  <Button fx:id="btnStats" maxWidth="Infinity" alignment="CENTER_LEFT" onAction="#showStats" styleClass="button-sidebar" text="   📈   Statistiques" />
               </children>
            </VBox>
            
            <!-- Logout -->
            <Button maxWidth="Infinity" onAction="#handleLogout" styleClass="sidebar-button-logout" text="🚪   Déconnexion">
               <padding>
                  <Insets bottom="15.0" top="15.0" />
               </padding>
            </Button>
         </children>
      </VBox>
   </left>
   <center>
      <!-- Content Area -->
      <StackPane fx:id="contentArea" styleClass="content-area" BorderPane.alignment="CENTER">
          <children>
              <Label text="Bienvenue dans l'administration" style="-fx-text-fill: #95a5a6; -fx-font-size: 24px; -fx-font-weight: 300;"/>
          </children>
      </StackPane>
   </center>
</BorderPane>
