<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.AdminController">
   <top>
       <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" style="-fx-background-color: #2c3e50; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">
           <padding>
               <Insets left="20.0" right="20.0" />
           </padding>
           <children>
               <Label style="-fx-text-fill: white; -fx-font-size: 24px; -fx-font-weight: bold;" text="ADMINISTRATION" />
            <AnchorPane HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#handleLogout" styleClass="button-danger" text="Déconnexion" />
           </children>
       </HBox>
   </top>
   <center>
      <TabPane tabClosingPolicy="UNAVAILABLE" BorderPane.alignment="CENTER">
        <tabs>
          <!-- TAB 1: GESTION UTILISATEURS -->
          <Tab text="Utilisateurs">
            <content>
              <VBox spacing="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                           <children>
                              <TextField fx:id="searchUserField" promptText="Rechercher par nom..." />
                              <Button mnemonicParsing="false" onAction="#handleSearchUsers" styleClass="button-primary" text="Rechercher" />
                           </children>
                        </HBox>
                        <TableView fx:id="usersTable" VBox.vgrow="ALWAYS">
                          <columns>
                            <TableColumn fx:id="colUserId" prefWidth="50.0" text="ID" />
                            <TableColumn fx:id="colUserName" prefWidth="150.0" text="Nom" />
                            <TableColumn fx:id="colUserEmail" prefWidth="200.0" text="Email" />
                            <TableColumn fx:id="colUserStatus" prefWidth="100.0" text="Statut" />
                            <TableColumn fx:id="colUserAction" prefWidth="150.0" text="Action" />
                          </columns>
                           <columnResizePolicy>
                              <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                           </columnResizePolicy>
                        </TableView>
                     </children>
                  </VBox>
            </content>
          </Tab>
          
          <!-- TAB 2: GESTION EVENEMENTS -->
          <Tab text="Événements">
            <content>
              <HBox spacing="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <!-- Formulaire Création -->
                        <VBox spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 5; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);" HBox.hgrow="NEVER" prefWidth="350">
                           <children>
                              <Label styleClass="label-title" text="Nouvel Événement" />
                              <TextField fx:id="evtNameField" promptText="Nom de l'événement" />
                              <DatePicker fx:id="evtDatePicker" promptText="Date" maxWidth="Infinity" />
                              <TextField fx:id="evtSportField" promptText="Sport (ex: Football)" />
                              <TextField fx:id="evtStadiumField" promptText="Stade (ex: Camp Nou)" />
                               <TextField fx:id="evtCityField" promptText="Ville" />
                               <TextField fx:id="evtCapacityField" promptText="Capacité" />
                              <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCreateEvent" styleClass="button-action" text="Créer l'événement" />
                           </children>
                        </VBox>
                        
                        <!-- Liste Événements -->
                        <VBox HBox.hgrow="ALWAYS" spacing="10.0">
                            <Label styleClass="label-title" text="Événements Existants" />
                            <TableView fx:id="eventsTable" VBox.vgrow="ALWAYS">
                                <columns>
                                    <TableColumn fx:id="colEvtId" text="ID" />
                                    <TableColumn fx:id="colEvtName" text="Nom" />
                                    <TableColumn fx:id="colEvtDate" text="Date" />
                                    <!-- Add columns for Adding categories later? -->
                                </columns>
                                 <columnResizePolicy>
                                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                 </columnResizePolicy>
                            </TableView>
                        </VBox>
                     </children>
                  </HBox>
            </content>
          </Tab>
          
          <!-- TAB 3: STATISTIQUES -->
          <Tab text="Statistiques">
            <content>
              <VBox alignment="TOP_CENTER" spacing="20.0">
                     <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                     </padding>
                     <children>
                        <Label styleClass="label-header" text="Chiffre d'Affaires par Événement" />
                        <Button onAction="#refreshStats" text="Actualiser les données" />
                        <BarChart fx:id="statsApp" title="Reventes Totales" VBox.vgrow="ALWAYS">
                          <xAxis>
                            <CategoryAxis label="Événement" side="BOTTOM" />
                          </xAxis>
                          <yAxis>
                            <NumberAxis label="CA (DH)" side="LEFT" />
                          </yAxis>
                        </BarChart>
                     </children>
                  </VBox>
            </content>
          </Tab>
        </tabs>
      </TabPane>
   </center>
</BorderPane>
