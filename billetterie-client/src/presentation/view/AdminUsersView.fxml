<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.AdminUsersController">
    <padding>
       <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
       <Label styleClass="h2, text-primary" text="Gestion des Utilisateurs" />
       
       <HBox alignment="CENTER_LEFT" spacing="15.0">
          <children>
             <TextField fx:id="searchUserField" prefWidth="350.0" promptText="Rechercher par nom ou email..." styleClass="form-control" />
             <Button mnemonicParsing="false" onAction="#handleSearchUsers" styleClass="btn, btn-primary" text="🔍 Rechercher" />
          </children>
       </HBox>
       
       <TableView fx:id="usersTable" styleClass="table-view" VBox.vgrow="ALWAYS">
         <columns>
           <TableColumn fx:id="colUserId" prefWidth="50.0" text="ID" />
           <TableColumn fx:id="colUserName" prefWidth="200.0" text="Nom" />
           <TableColumn fx:id="colUserEmail" prefWidth="250.0" text="Email" />
           <TableColumn fx:id="colUserStatus" prefWidth="100.0" text="Statut" />
           <TableColumn fx:id="colUserAction" prefWidth="150.0" text="Action" />
         </columns>
          <columnResizePolicy>
             <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
          </columnResizePolicy>
       </TableView>
    </children>
</VBox>
