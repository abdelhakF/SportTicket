<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.CartController">
   <top>
       <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" styleClass="card" style="-fx-background-radius: 0; -fx-padding: 0 20;">
           <padding>
               <Insets left="20.0" right="20.0" />
           </padding>
           <children>
               <Button mnemonicParsing="false" onAction="#handleBack" styleClass="button-secondary" text="← Retour" />
               <Label styleClass="label-header" text="Mon Panier" />
           </children>
       </HBox>
   </top>
   <center>
      <VBox spacing="20.0" styleClass="content-container">
         <children>
            <TableView fx:id="cartTable" prefHeight="400.0" styleClass="table-view" VBox.vgrow="ALWAYS">
              <columns>
                <TableColumn fx:id="colEvent" prefWidth="300.0" text="Événement" />
                <TableColumn fx:id="colCategory" prefWidth="200.0" text="Catégorie" />
                <TableColumn fx:id="colPrice" prefWidth="100.0" text="Prix Unitaire" />
                <TableColumn fx:id="colQty" prefWidth="100.0" text="Quantité" />
                <TableColumn fx:id="colTotal" prefWidth="100.0" text="Total" />
                <TableColumn fx:id="colActions" prefWidth="100.0" text="Actions" />
              </columns>
               <columnResizePolicy>
                  <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
               </columnResizePolicy>
            </TableView>
            
            <HBox alignment="CENTER_RIGHT" spacing="20.0" styleClass="card">
               <padding>
                  <Insets bottom="15.0" left="20.0" right="20.0" top="15.0" />
               </padding>
               <children>
                  <Label styleClass="label-title" text="Total à payer :" />
                  <Label fx:id="totalLabel" styleClass="label-header" text="0.00 DH" />
               </children>
            </HBox>
            
            <HBox alignment="CENTER_RIGHT" spacing="15.0">
               <children>
                  <Button mnemonicParsing="false" onAction="#handleClearParams" styleClass="button-danger" text="Vider le panier" />
                  <Button mnemonicParsing="false" onAction="#handlePay" styleClass="button-primary" text="💳 PAYER MAINTENANT" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>
