<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.AdminEventsController">
    <padding>
       <Insets bottom="30.0" left="30.0" right="30.0" top="30.0" />
    </padding>
    <children>
       <Label styleClass="h2, text-primary" text="Gestion des Événements" />
       
       <HBox spacing="30.0" VBox.vgrow="ALWAYS">
            <children>
               <!-- Formulaire Création -->
               <VBox spacing="15.0" styleClass="card-elevated" HBox.hgrow="NEVER" prefWidth="380">
                  <children>
                     <Label styleClass="h4, text-secondary" text="Nouvel Événement" />
                     <TextField fx:id="evtNameField" promptText="Nom de l'événement" styleClass="form-control" />
                     <DatePicker fx:id="evtDatePicker" promptText="Date (yyyy-MM-dd)" maxWidth="Infinity" styleClass="form-control" />
                     <TextField fx:id="evtTimeField" promptText="Heure (HH:mm, ex: 20:00)" maxWidth="Infinity" styleClass="form-control" />
                     <ComboBox fx:id="evtSportCombo" promptText="Sélectionner un sport" maxWidth="Infinity" editable="true" styleClass="form-control" />
                     <TextField fx:id="evtStadiumField" promptText="Stade (ex: Camp Nou)" styleClass="form-control" />
                      <TextField fx:id="evtCityField" promptText="Ville" styleClass="form-control" />
                      <TextField fx:id="evtCapacityField" promptText="Capacité" styleClass="form-control" />
                     <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#handleCreateEvent" styleClass="btn, btn-success" text="➕ Créer l'événement" />
                  </children>
               </VBox>
               
               <!-- Liste Événements -->
               <VBox HBox.hgrow="ALWAYS" spacing="15.0">
                   <Label styleClass="h4, text-secondary" text="Événements Existants" />
                   <TableView fx:id="eventsTable" styleClass="table-view" VBox.vgrow="ALWAYS">
                       <columns>
                           <TableColumn fx:id="colEvtId" text="ID" />
                           <TableColumn fx:id="colEvtName" text="Nom" />
                           <TableColumn fx:id="colEvtDate" text="Date" />
                       </columns>
                        <columnResizePolicy>
                           <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                   </TableView>
                   <Button text="🗑 Supprimer l'événement sélectionné" styleClass="btn, btn-danger" maxWidth="Infinity" onAction="#handleDeleteEvent"/>
               </VBox>
            </children>
         </HBox>
    </children>
</VBox>
