<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1000.0" stylesheets="@../../resources/css/style.css" xmlns="http://javafx.com/javafx/19" xmlns:fx="http://javafx.com/fxml/1" fx:controller="presentation.controller.EventDetailController">
   <top>
       <HBox alignment="CENTER_LEFT" prefHeight="70.0" spacing="20.0" styleClass="card" style="-fx-background-radius: 0; -fx-padding: 0 20;">
           <padding>
               <Insets left="20.0" right="20.0" />
           </padding>
           <children>
               <Button mnemonicParsing="false" onAction="#handleBack" styleClass="btn, btn-secondary" text="← Retour" />
               <Label styleClass="h3, text-primary" text="Détails de l'événement" />
            <AnchorPane HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#goToCart" styleClass="btn, btn-primary" text="🛒 Voir mon Panier" />
           </children>
       </HBox>
   </top>
   <center>
      <ScrollPane fitToWidth="true" styleClass="scroll-pane">
         <content>
            <VBox spacing="30.0" styleClass="content-container">
               <children>
                  <!-- Header Info -->
                  <VBox spacing="15.0" styleClass="card-elevated">
                     <children>
                        <Label fx:id="eventNameLabel" styleClass="h2, text-primary" text="Nom de l'événement" />
                        <HBox spacing="30.0">
                           <children>
                              <Label fx:id="dateLabel" styleClass="h4, text-secondary" text="Date" />
                              <Label fx:id="locationLabel" styleClass="h5, text-muted" text="Lieu" />
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  
                  <Label styleClass="h4, text-dark" text="Catégories disponibles" />
                  <Label style="-fx-text-fill: #e74c3c; -fx-font-style: italic;" text="Veuillez consulter le panier pour finaliser le paiement après réservation." />
                  
                  <!-- Dynamic Categories List -->
                  <VBox fx:id="categoriesContainer" spacing="15.0">
                     <!-- Categories will be added here dynamically -->
                  </VBox>
               </children>
            </VBox>
         </content>
      </ScrollPane>
   </center>
</BorderPane>
